<?xml version="1.0" encoding="UTF-8"?>
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
	bootstrap="tests/bootstrap-examples.php"
	backupGlobals="false"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	beStrictAboutOutputDuringTests="true"
	failOnWarning="true"
	failOnRisky="true"
	convertDeprecationsToExceptions="false"
	>
	<testsuites>
		<testsuite name="examples">
			<directory prefix="test-" suffix=".php">examples/vault-provider/tests</directory>
			<directory prefix="test-" suffix=".php">examples/aws-secrets-manager/tests</directory>
		</testsuite>
	</testsuites>
</phpunit>
