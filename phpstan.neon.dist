includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

services:
	# Core documents globals with `@global Type $name` on the function docblock, and
	# core's own PHPStan setup reads those tags through this visitor. It is core's
	# tests/phpstan/GlobalDocBlockVisitor.php, copied unchanged, so that src/ is
	# analyzed here the way it will be in wordpress-develop.
	-
		class: WordPress\PHPStan\GlobalDocBlockVisitor
		tags:
			- phpstan.parser.richParserNodeVisitor

parameters:
	level: 10
	phpVersion: 70400
	paths:
		- src
		- plugin
		- cli
		- secrets-api.php
	scanDirectories:
		- src
	scanFiles:
		- vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
		- vendor/php-stubs/wp-cli-stubs/wp-cli-commands-stubs.php
		- tests/phpstan/compat-stubs.php
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	treatPhpDocTypesAsCertain: false
	ignoreErrors:
		# Interpolating a `$wpdb` table name into the query handed to prepare() is the
		# core idiom, and core's own signature for prepare() takes a plain string. The
		# `literal-string` here comes from the WordPress stubs, which are stricter than
		# the method they describe; core's PHPStan run does not report these lines.
		-
			message: '#^Parameter \#1 \$query of method wpdb::prepare\(\) expects literal-string, non-falsy-string given\.$#'
			paths:
				- src/wp-includes/secrets/class-wp-secrets-option-store.php
				- src/wp-includes/secrets/class-wp-secrets-key-manager.php
				- plugin/class-secrets-api-legacy-reader.php
		# r64674's no-op check reads $existing['current'] behind $is_unchanged, which is
		# only true when $has_current is. PHPStan narrows $existing through $has_current
		# but not through $is_unchanged. src/ stays as core committed it, so the one
		# line is ignored here rather than rewritten.
		-
			message: '#^Cannot access offset ''needs_rotation'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			path: src/wp-includes/secrets/class-wp-secrets-libsodium-provider.php
			count: 1
		# r65373 writes the root key row with $wpdb directly. The stubs type
		# $wpdb->sitemeta as string|null, because it is set only on multisite, and the
		# two calls that use it run only on multisite. wpdb::prepare() returns null only
		# for a malformed query, and core passes its result straight to query(), as
		# this does. src/ stays as core committed it.
		-
			message: '#^Parameter \#1 \$(table|query) of method wpdb::(delete|insert|query)\(\) expects string, string\|null given\.$#'
			identifier: argument.type
			path: src/wp-includes/secrets/class-wp-secrets-key-manager.php
			count: 3
